{
  "name": "rabdelaal.github.io",
  "version": "2.0.0",
  "private": true,
  "engines": {
    "node": ">=16"
  },
  "description": "Static site for Romain Abdel-Aal — Research & Architecture. No build step: vanilla HTML/CSS/JS, vendored marked.min.js.",
  "scripts": {
    "ci:validate": "npx html-validate \"index.html\" \"calculator.html\" \"blog/*.html\" \"papers/*.html\" && npx linkinator --file index.html --recursive --skip \"^https?://\"",
    "serve": "python -m http.server 8000"
  },
  "devDependencies": {
    "html-validate": "^7.11.0",
    "linkinator": "^2.9.0"
  }
}
